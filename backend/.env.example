# SQLite by default — swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/civisense
DATABASE_URL=sqlite:///./civisense.db

# Where uploaded photos/voice notes are stored on disk
UPLOAD_DIR=./uploads

# Comma-separated origins allowed to call this API (your frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5180

# Auth — change this in any real deployment; this default is for local dev only.
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRE_MINUTES=10080
